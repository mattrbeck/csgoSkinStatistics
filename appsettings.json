{
  // Comments are fine here: this file is read only by ASP.NET Core's JSON configuration provider,
  // which parses with JsonCommentHandling.Skip. Nothing else in the repo reads it.
  "Logging": {
    "LogLevel": {
      // The floor for anything without a more specific entry below. Most specific prefix wins.
      "Default": "Information",
      "Microsoft.AspNetCore.*": "Warning",

      // The one knob for this app's own logging. Every category the app emits under is
      // CSGOSkinAPI.* - the services and the controller by type name, plus the three literal
      // categories Program.cs creates (CSGOSkinAPI.Startup, CSGOSkinAPI.RateLimiting and
      // CSGOSkinAPI.UnhandledException) for the lines that have no type to belong to. So setting
      // this to "Warning" in production turns off all of the routine flow at once - the parse
      // summaries, cache misses, Steam session chatter - and leaves only what an operator can act
      // on. "Debug" turns the flow back on when following one request; "Trace" adds the per-item
      // work that scales with inventory size (individual GC sends, the per-account pacing waits)
      // and is far too loud to leave on.
      "CSGOSkinAPI": "Information",

      // Pinned, and deliberately NOT just inherited from the line above. These two lines exist to
      // make a mis-set trust boundary visible - the startup line naming the resolved
      // KnownNetworks/KnownProxies, and the once-per-host warning that forwarded headers arrived
      // from a peer outside it. Every way that boundary can be wrong otherwise produces a
      // working-looking app whose rate limiter has quietly collapsed to a single global bucket.
      //
      // Be aware of what this entry does and does not buy. It outranks the CATEGORY-scoped knobs
      // (Logging:LogLevel:*), because a longer category prefix wins. It does NOT outrank the
      // PROVIDER-scoped ones (Logging:Console:LogLevel:*), because LoggerRuleSelector ranks any
      // rule carrying a provider above any rule without one, whatever the categories say - so
      // Logging__Console__LogLevel__Default=Warning would silence the startup line and =None would
      // silence both, from a setting whose author only wanted less log volume.
      //
      // TransportSecurity.PinTrustBoundaryLogging closes that gap in code, by pinning this
      // category under every provider an operator has scoped a rule to. Between the two, these
      // lines cannot be turned down by configuration at all - deliberately, and defensible only
      // because the volume is one line at startup and one per host. Changing this value alone will
      // therefore not quieten them; remove the code pin as well, and read its comment first.
      "CSGOSkinAPI.Security": "Information",

      // Rate-limit rejections. Split out because their volume is set by whoever is calling us
      // rather than by anything the app is doing - a scripted client can produce a lot of them -
      // so it is worth being able to mute a flood on its own. Raise to "Error" for that.
      // CSGOSkinAPI.InspectLinks below is the other category of that kind.
      "CSGOSkinAPI.RateLimiting": "Information",

      // Malformed inspect links: an unparseable ?url=, a hex payload of the wrong length, a cert
      // that will not decode. Every one of these is a caller's request rather than a fault of
      // ours, the caller already has their answer (a 400), and the line carries up to 200
      // characters of their choosing - so it is both the highest-volume and the most
      // caller-influenced thing this app logs. Warning by default, because a burst of them is
      // still worth seeing; raise to "Error" to mute them entirely without touching the app's own
      // diagnostics. The same failures reached through the background inventory warmer log under
      // CSGOSkinAPI.Services.InventoryWarmService instead, where the link came from Steam's feed
      // rather than from a caller and is genuinely notable.
      "CSGOSkinAPI.InspectLinks": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenLimit": 40,
    "TokensPerPeriod": 20,
    "ReplenishmentPeriodSeconds": 1,
    "QueueLimit": 10
  },
  // What every steamcommunity.com request identifies itself as. Configuration rather than code so
  // the next time Steam changes what it accepts (2026-09-12: it began refusing requests with no
  // User-Agent, and browser-shaped ones without a browser's other headers), the fix is an edit and
  // a restart on the box. Keep it a plain product token - see the "steam" client in Program.cs.
  "Steam": {
    "UserAgent": "skinstats.app/1.0 (+https://skinstats.app)"
  },
  // The one process-wide gate on inventory fetches to steamcommunity.com (SteamEgressGate). Steam
  // throttles that endpoint per source IP and a ban lasts hours, so fetches are serialized and
  // spaced, viewers queue briefly rather than pile on, and a 429 pauses everyone.
  "SteamEgress": {
    "MinIntervalSeconds": 2.0,
    "MaxWaiters": 24,
    "MaxWaitSeconds": 15.0,
    "PauseOnRateLimitSeconds": 300.0
  },
  // Last-good inventory copies served (marked stale) while Steam is throttling or down. Both
  // knobs bound the on-disk table; see InventorySnapshotOptions.
  "InventorySnapshots": {
    "RetentionDays": 7,
    "MaxRows": 2000
  }
}
