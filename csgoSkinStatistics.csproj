<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- <Nullable>enable</Nullable> above already makes the compiler run full nullable reference
         analysis on every build - it was only its output that nothing acted on, so CS8602/CS8604
         findings scrolled past in the log and shipped. This turns that existing signal into a gate.
         It lives in the project rather than on a CI switch so `dotnet build`, `dotnet test` and
         `dotnet publish` all enforce the same bar, locally and in CI, at the moment the warning is
         introduced. If a build fails here, fix the warning - do not turn this off. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="SteamKit2" Version="3.3.1" />
    <!-- Microsoft.Data.Sqlite pulls the native SQLite through SQLitePCLRaw.lib.e_sqlite3,
         whose whole 2.1.x line ships a SQLite with GHSA-2m69-gcr7-jv3q and has no patched
         release. Pin the native lib forward to the 3.5x line (SQLite 3.53.3), which is
         dependency-free native binaries with a stable provider ABI, so it drops in over the
         classic 2.1.x provider/core and lifts the resolved version out of the vulnerable range. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="csgoSkinStatistics.Tests/**" />
    <Content Remove="csgoSkinStatistics.Tests/**" />
    <None Remove="csgoSkinStatistics.Tests/**" />
  </ItemGroup>

  <!-- Live Steam secrets live beside the project (gitignored, never committed). The Web SDK's
       default Content glob (**/*.json) would otherwise copy them into the publish output, so
       exclude them explicitly. -->
  <ItemGroup>
    <Content Remove="steam-tokens.json;steam-accounts.json" />
  </ItemGroup>

  <!-- Marketplace WIP bundle (gitignored). Excluding it from the default item globs keeps it out of
       the build entirely, so it isn't collected as a static web asset and can't ship until ready. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/market/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
